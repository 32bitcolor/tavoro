// Tavoro — Instructional Designer Workspace
// Prisma 7 schema. Client is generated to src/generated/prisma (see generator).
// Phase 0 covers identity & tenancy only; feature models (boards, projects,
// storyboards, exams, LMS) are added in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER // oversight role: same "see everything" board/project/etc. visibility as ADMIN, but no user/group/workspace-settings management
  MEMBER
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  name                    String?
  passwordHash            String
  /// Sessions signed before this are void (password changed or reset).
  sessionsValidAfter      DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  memberships             Membership[]
  assignedCards           CardAssignee[]
  smeCards                CardSme[]
  comments                Comment[]
  reviewCycles            ReviewCycle[]     @relation("ReviewReviewer")
  requestedReviews        ReviewCycle[]     @relation("ReviewRequester")
  startedReviewRounds     ReviewRound[]     @relation("ReviewRoundCreator")
  uploadedReviewFiles     ReviewFile[]
  overriddenReviewRounds  ReviewRound[]     @relation("ReviewRoundOverride")
  reviewComments          ReviewComment[]   @relation("ReviewCommentAuthor")
  resolvedReviewComments  ReviewComment[]   @relation("ReviewCommentResolver")
  timeEntries             TimeEntry[]
  groupMemberships        GroupMembership[]
  whiteboards             Whiteboard[]
  submittedIntakeRequests IntakeRequest[]   @relation("IntakeRequester")
  assignedIntakeRequests  IntakeRequest[]   @relation("IntakeAssignee")
  savedViews              SavedView[]
  apiTokens               ApiToken[]
  oauthCodes              OAuthCode[]
  ssoIdentities           SsoIdentity[]
  idpGroupMemberships     IdpGroupMember[]
  publicBoards            Board[]           @relation("BoardPublicSharer")
  intakeDecisions         IntakeRequest[]   @relation("IntakeDecider")
  intakeMessages          IntakeMessage[]   @relation("IntakeMessageAuthor")
}

model Workspace {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  intakeEnabled        Boolean           @default(true) // admin on/off toggle for the public intake form
  formerSlugs          String[]          @default([]) // intake links it used to have; /request/<old> forwards to the current one
  publicBoardsEnabled  Boolean           @default(true) // admin switch: off hides every board's public link (lib/board-share.ts)
  notificationSettings Json? // admin per-type email toggles; null/absent key = enabled (opt-out). See src/lib/notifications.ts
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  members              Membership[]
  boards               Board[]
  projects             Project[]
  storyboards          Storyboard[]
  whiteboards          Whiteboard[]
  groups               Group[]
  intakeRequests       IntakeRequest[]
  statuses             WorkspaceStatus[]
  sprints              Sprint[]
  labels               Label[]
  savedViews           SavedView[]
  reviewFiles          ReviewFile[]
  apiTokens            ApiToken[]
  ssoConnection        SsoConnection?
}

// Workspace/team-level, time-boxed grouping of work — independent of a project's
// ADDIE/SAM phases. One sprint can span projects; the team sprint board is a view
// over its cards. Projects opt in via Project.sprintsEnabled.
model Sprint {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  goal        String?
  status      String    @default("planned") // planned / active / completed
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards       Card[]

  @@index([workspaceId, status])
}

// Role is per-workspace (on Membership), never global on User.
// All authorization resolves a user's role within the workspace owning a resource.
model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  // Set when the identity provider deactivates the member (docs/SSO.md): they can't
  // sign in or use the workspace, but everything they made stays attributed to them.
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ── Kanban (Phase 1) ─────────────────────────────────────────────────────────
// Ordering uses fractional-index strings (`position`): inserting between two
// items computes a key between their keys — a single-row update, no renumbering.

// Canonical, per-workspace status vocabulary. A board's columns each map to one
// of these; cross-project views (e.g. the team sprint board) group cards by
// them. Seeded with defaults on workspace creation; admin-editable.
model WorkspaceStatus {
  id          String    @id @default(cuid())
  workspaceId String
  name        String // "Backlog" · "To do" · "In progress" · "In review" · "Done"
  category    String    @default("active") // todo / active / done — for done-detection & WIP
  position    String // fractional-index ordering (lib/ordering.ts)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  cards       Card[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model Board {
  id                  String         @id @default(cuid())
  workspaceId         String
  projectId           String? // null = standalone "quick board"; set = one of a project's boards
  name                String
  cardKeyPrefix       String? // e.g. "WP" — when set, every card created under this board (including subtasks) gets a sequential "WP-123" key
  cardKeySeq          Int            @default(0) // last card key number issued; incremented atomically on card creation
  // Public read-only link (lib/board-share.ts). Set = shared; the link is an HMAC over
  // the nonce, so a database dump can't produce one. A new nonce kills the old link.
  publicNonce         String?
  publicShowAssignees Boolean        @default(false)
  publicSharedAt      DateTime?
  publicSharedById    String?
  publicSharedBy      User?          @relation("BoardPublicSharer", fields: [publicSharedById], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  columns             Column[]
  groupAccess         BoardGroup[]
  savedViews          SavedView[]
  keyAliases          CardKeyAlias[]

  @@unique([workspaceId, cardKeyPrefix])
  @@index([workspaceId])
  @@index([projectId])
}

model Column {
  id        String           @id @default(cuid())
  boardId   String
  statusId  String? // the canonical status this column represents (drives card.statusId on move)
  name      String
  position  String
  createdAt DateTime         @default(now())
  board     Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status    WorkspaceStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  cards     Card[]

  @@index([boardId, position])
}

model Card {
  id             String           @id @default(cuid())
  columnId       String? // null means this card is a subtask (see parentCardId)
  parentCardId   String? // set means this card IS a subtask, nested one level under another card
  title          String
  description    String? // TipTap document, stored as JSON string
  dueDate        DateTime?
  done           Boolean          @default(false) // only meaningful for subtask-cards
  private        Boolean          @default(false) // never shown on the board's public link (top-level cards; subtasks follow their card)
  keySeq         Int? // this card's number in its board's key sequence — null if the board has no cardKeyPrefix; display as "{board.cardKeyPrefix}-{keySeq}"
  statusId       String? // canonical status — source of truth for cross-board views; kept in sync with the card's column on move
  sprintId       String? // optional sprint assignment (independent of project); powers the team sprint board
  completedAt    DateTime? // when it entered a "done"-category status; set by a DB trigger (see migration card_completed_at), never by app code
  position       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  column         Column?          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  parentCard     Card?            @relation("CardSubtasks", fields: [parentCardId], references: [id], onDelete: Cascade)
  subtasks       Card[]           @relation("CardSubtasks")
  status         WorkspaceStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  sprint         Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  labels         CardLabel[]
  assignees      CardAssignee[]
  smes           CardSme[]
  comments       Comment[]
  attachments    Attachment[]
  deliverables   Deliverable[]
  whiteboards    Whiteboard[]
  reviewComments ReviewComment[]
  keyAliases     CardKeyAlias[]

  @@index([columnId, position])
  @@index([parentCardId, position])
  @@index([statusId])
  @@index([sprintId])
  @@index([completedAt])
}

// A key a card had on a board it has since been moved off (e.g. SEC-12 after moving to
// OPS), so old short links, mentions and searches still find it. The old board's key
// sequence never reissues the number.
model CardKeyAlias {
  id      String @id @default(cuid())
  boardId String
  keySeq  Int
  cardId  String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([boardId, keySeq])
  @@index([cardId])
}

model Attachment {
  id           String   @id @default(cuid())
  cardId       String
  workspaceId  String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String
  createdAt    DateTime @default(now())
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// ── Project management (Phase 2) ─────────────────────────────────────────────

enum Methodology {
  ADDIE
  SAM
  CUSTOM
}

model Project {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  methodology     Methodology         @default(ADDIE)
  status          String              @default("active") // active / on_hold / completed
  sprintsEnabled  Boolean             @default(false) // opt-in: surface sprint planning for this project
  completedAt     DateTime? // when status became "completed"; set by a DB trigger, never by app code
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phases          Phase[]
  deliverables    Deliverable[]
  milestones      Milestone[]
  timeEntries     TimeEntry[]
  groupAccess     ProjectGroup[]
  objectives      LearningObjective[]
  assessmentItems AssessmentItem[]
  intakeRequest   IntakeRequest?
  boards          Board[]

  @@index([workspaceId])
}

model Phase {
  id           String        @id @default(cuid())
  projectId    String
  name         String
  position     String
  status       String        @default("not_started") // not_started / in_progress / done
  startDate    DateTime?
  endDate      DateTime?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  @@index([projectId, position])
}

model Deliverable {
  id           String        @id @default(cuid())
  projectId    String
  phaseId      String?
  cardId       String?
  name         String
  type         String        @default("other") // storyboard / assessment / job_aid / video / document / other
  status       String        @default("not_started") // not_started / in_progress / in_review / complete
  position     String
  createdAt    DateTime      @default(now())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        Phase?        @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  reviewCycles ReviewCycle[]
  reviewRounds ReviewRound[]
  reviewFiles  ReviewFile[]
  timeEntries  TimeEntry[]
  storyboard   Storyboard?

  @@index([projectId, position])
}

// One reviewer's assignment and decision within a ReviewRound. (Before review rounds
// existed this row WAS the round; `round` is kept and mirrors ReviewRound.number so
// existing queries and history keep working.)
model ReviewCycle {
  id            String       @id @default(cuid())
  deliverableId String
  roundId       String
  // Exactly one of reviewerId / guestId (CHECK in the review_guests migration).
  reviewerId    String?
  guestId       String?      @unique
  requestedById String? // who set up the review (null for legacy rows)
  round         Int
  status        String       @default("requested") // requested / in_review / changes_requested / approved
  dueDate       DateTime?
  feedback      String? // the reviewer's summary that goes with their decision
  decidedAt     DateTime? // when it last became approved / changes_requested
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deliverable   Deliverable  @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  reviewRound   ReviewRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reviewer      User?        @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  guest         ReviewGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)
  requestedBy   User?        @relation("ReviewRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([roundId, reviewerId])
  @@index([deliverableId])
  @@index([reviewerId])
  @@index([requestedById])
}

// One round of review on a deliverable: what was reviewed (frozen), who reviews it,
// and how it ended. See docs/REVIEW-LINKS.md.
model ReviewRound {
  id             String          @id @default(cuid())
  deliverableId  String
  number         Int // 1, 2, 3… per deliverable
  targetKind     String          @default("none") // storyboard / file / none (external_url comes in phase 5)
  // Frozen copy of the linked storyboard at round start — see lib/review-snapshot.ts.
  snapshot       Json?
  fileId         String? // targetKind = file: the PDF/image under review (immutable)
  dueDate        DateTime?
  createdById    String?
  closedAt       DateTime?
  // null while open · "passed" (every reviewer approved, or an ADMIN/MANAGER override)
  // · "changes_requested" (everyone decided, at least one asked for changes)
  outcome        String?
  overriddenById String?
  overriddenAt   DateTime?
  overrideReason String?
  createdAt      DateTime        @default(now())
  deliverable    Deliverable     @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("ReviewRoundCreator", fields: [createdById], references: [id], onDelete: SetNull)
  overriddenBy   User?           @relation("ReviewRoundOverride", fields: [overriddenById], references: [id], onDelete: SetNull)
  file           ReviewFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  assignments    ReviewCycle[]
  comments       ReviewComment[]

  @@unique([deliverableId, number])
}

// A comment on a review round, anchored to what it's about (lib/review-anchor.ts).
model ReviewComment {
  id           String          @id @default(cuid())
  roundId      String
  parentId     String? // one level of threading
  authorId     String? // at most one of authorId / guestId (CHECK); both null = author since deleted
  guestId      String?
  body         String // TipTap document, stored as JSON string
  anchor       Json
  status       String          @default("open") // open / resolved / wont_fix
  resolvedById String?
  resolvedNote String?
  resolvedAt   DateTime?
  // Set once the comment is sent to a board (docs/REVIEW-LINKS.md, phase 4): the card
  // itself, or a subtask when several comments went to one card as a checklist.
  cardId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  round        ReviewRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  parent       ReviewComment?  @relation("ReviewCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ReviewComment[] @relation("ReviewCommentThread")
  author       User?           @relation("ReviewCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  guest        ReviewGuest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  resolvedBy   User?           @relation("ReviewCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  card         Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([roundId, status])
  @@index([parentId])
  @@index([cardId])
}

// An outside reviewer's credential for ONE assignment — not a User, no Membership, so
// nothing in authz.ts can ever return it (docs/REVIEW-LINKS.md, locked decision 1). The
// link is "<id>.<HMAC(SESSION_SECRET, id:nonce)>" (lib/review-guest.ts): only the nonce
// is stored, so a database dump can't be replayed, yet the app can re-send the link.
// Rotating the nonce kills the old link.
// A file under review: a PDF (e.g. a Storyline/Rise export) or an image. Immutable — a new
// version is a new upload on the next round. Not an Attachment: those belong to cards.
// Uploaded for one deliverable, whose access rules gate reading it.
model ReviewFile {
  id            String        @id @default(cuid())
  workspaceId   String
  deliverableId String
  fileName      String
  mimeType      String // application/pdf, image/png, image/jpeg, image/webp, image/gif
  sizeBytes     Int
  storageKey    String        @unique
  uploadedById  String?
  createdAt     DateTime      @default(now())
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliverable   Deliverable   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  uploadedBy    User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  rounds        ReviewRound[]

  @@index([deliverableId])
}

model ReviewGuest {
  id         String          @id @default(cuid())
  name       String
  email      String
  nonce      String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime        @default(now())
  assignment ReviewCycle?
  comments   ReviewComment[]
}

model TimeEntry {
  id            String       @id @default(cuid())
  projectId     String
  deliverableId String?
  userId        String
  minutes       Int
  note          String?
  loggedFor     DateTime
  createdAt     DateTime     @default(now())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  position    String
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

// ── Intake & demand management ───────────────────────────────────────────────
// The front door: stakeholders (workspace members or, more commonly, external
// requesters with no login) submit a request; the ID team scores it (impact vs.
// effort) and, once approved, it converts into a real Project.
model IntakeRequest {
  id          String @id @default(cuid())
  workspaceId String
  number      Int // sequential per workspace; "REQ-<number>" is display-only

  requesterName  String
  requesterEmail String
  requestedById  String? // set only if a logged-in Member submitted it

  title          String
  description    String
  targetAudience String?
  targetDate     DateTime?

  impactScore Int? // 1-5, null until triaged
  effortScore Int? // 1-5, null until triaged

  status             String    @default("submitted") // submitted / triaging / needs_info / rejected / converted (lib/intake.ts)
  assignedToId       String?
  rejectionReason    String?
  convertedProjectId String?   @unique
  // Who approved or rejected it, and when (cleared when a rejected request is reopened).
  decidedById        String?
  decidedAt          DateTime?
  // The requester's private status page: /status/<id>-<HMAC(SESSION_SECRET, nonce)>
  // (lib/intake-status.ts). A new nonce ("Reset link") kills the old link.
  statusNonce        String    @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy      User?           @relation("IntakeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo       User?           @relation("IntakeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedProject Project?        @relation(fields: [convertedProjectId], references: [id], onDelete: SetNull)
  decidedBy        User?           @relation("IntakeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  messages         IntakeMessage[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

// The conversation on an intake request. "reply" messages are between the team and the
// requester (emailed to them, shown on their status page); "note" messages are internal.
// A message from the requester has no author.
model IntakeMessage {
  id            String        @id @default(cuid())
  requestId     String
  kind          String        @default("reply") // reply / note
  fromRequester Boolean       @default(false)
  authorId      String?
  body          String
  createdAt     DateTime      @default(now())
  request       IntakeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author        User?         @relation("IntakeMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// ── Storyboarding (Phase 3) ──────────────────────────────────────────────────
// A storyboard is workspace-scoped (like a Board) and may optionally be linked to
// a project Deliverable of type "storyboard". It holds an ordered list of Screens.

model Storyboard {
  id            String            @id @default(cuid())
  workspaceId   String
  deliverableId String?           @unique
  title         String
  description   String?
  status        String            @default("draft") // draft / in_review / approved
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliverable   Deliverable?      @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  screens       Screen[]
  groupAccess   StoryboardGroup[]
  whiteboards   Whiteboard[]

  @@index([workspaceId])
}

model Screen {
  id               String            @id @default(cuid())
  storyboardId     String
  title            String
  screenType       String            @default("content") // intro / content / video / knowledge_check / interaction / assessment / summary
  position         String
  onScreenText     String? // TipTap document, stored as JSON string
  narration        String? // TipTap document — voiceover / audio script
  visualNotes      String? // TipTap document — visuals, media, layout
  interactionNotes String? // TipTap document — interactions, branching, programming
  developerNotes   String? // TipTap document — production / developer notes
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  storyboard       Storyboard        @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  objectives       ScreenObjective[]

  @@index([storyboardId, position])
}

// ── Learning objectives & the alignment spine ─────────────────────────────────
// Objectives belong to a project. Screens "teach" them (ScreenObjective) and
// assessment items "assess" them (AssessmentItemObjective) — giving a coverage /
// gap view over the ID's craft: objective → content → assessment.

model LearningObjective {
  id          String                    @id @default(cuid())
  projectId   String
  text        String
  bloomLevel  String                    @default("understand") // remember/understand/apply/analyze/evaluate/create
  position    String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  screens     ScreenObjective[]
  assessments AssessmentItemObjective[]

  @@index([projectId, position])
}

model ScreenObjective {
  screenId    String
  objectiveId String
  screen      Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([screenId, objectiveId])
  @@index([objectiveId])
}

model AssessmentItem {
  id         String                    @id @default(cuid())
  projectId  String
  prompt     String
  itemType   String                    @default("multiple_choice") // multiple_choice/true_false/short_answer/scenario/other
  position   String
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  project    Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectives AssessmentItemObjective[]

  @@index([projectId, position])
}

model AssessmentItemObjective {
  itemId      String
  objectiveId String
  item        AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([itemId, objectiveId])
  @@index([objectiveId])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

// Workspace-level (not board-level) so a label means the same thing everywhere and
// cross-project views — the team sprint board — can filter by it. Names are unique
// per workspace, case-insensitively (enforced by a lower(name) index, see the
// workspace_level_labels migration; Prisma can't express a functional unique index).
model Label {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  color       String // hex like "#ef4444"
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards       CardLabel[]

  @@index([workspaceId, name])
}

// A named, reusable set of filters — the second half of Phase 5. Personal to the
// user who saved it (filters are a working preference, not shared workspace config).
// scope "board" pins the view to one board, since its label/assignee ids only mean
// something there; scope "sprint" applies to any sprint board, which is inherently
// cross-project. `filters` holds the scope's filter shape verbatim — see
// lib/saved-views.ts, which is the single place that knows those shapes.
model SavedView {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  scope       String // "board" | "sprint"
  boardId     String? // set when scope = "board"
  filters     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  board       Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([userId, scope, boardId])
  @@index([workspaceId])
  @@index([boardId])
}

model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model CardAssignee {
  cardId String
  userId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// Subject-matter experts advising on a card — a workspace member designated as
// the SME, distinct from the assignee(s) doing the work.
model CardSme {
  cardId String
  userId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

// ── Groups & access control ──────────────────────────────────────────────────
// A Group is a named set of workspace members. Access is DEFAULT-OPEN: a board /
// storyboard / project is visible to every workspace member UNTIL it is shared
// with one or more groups, after which only members of those groups (plus
// workspace ADMINs, who always have access) can see it. See src/lib/authz.ts.

model Group {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     GroupMembership[]
  boards      BoardGroup[]
  storyboards StoryboardGroup[]
  projects    ProjectGroup[]
  whiteboards WhiteboardGroup[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model GroupMembership {
  groupId String
  userId  String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// Resource ↔ group access grants. Presence of any row restricts the resource to
// the granted groups; absence of rows leaves it open to all workspace members.

model BoardGroup {
  boardId String
  groupId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([boardId, groupId])
  @@index([groupId])
}

model StoryboardGroup {
  storyboardId String
  groupId      String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([storyboardId, groupId])
  @@index([groupId])
}

model ProjectGroup {
  projectId String
  groupId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([projectId, groupId])
  @@index([groupId])
}

// ── Whiteboards ──────────────────────────────────────────────────────────────
// A collaborative sketch canvas (Excalidraw). Workspace-scoped like a Board, may
// optionally be linked to a Storyboard. `scene` holds the serialized Excalidraw
// document (elements + files + a little appState) as a JSON string. Persisted /
// autosaved (last-write-wins); realtime multi-cursor is a future addition.

model Whiteboard {
  id           String            @id @default(cuid())
  workspaceId  String
  storyboardId String?
  cardId       String?
  createdById  String? // the ID who created/owns it
  title        String
  scene        String? // Excalidraw scene JSON
  sceneVersion Int               @default(0) // bumped on every scene write (lib/whiteboard-store.ts)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  storyboard   Storyboard?       @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  card         Card?             @relation(fields: [cardId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  groupAccess  WhiteboardGroup[]

  @@index([workspaceId])
  @@index([storyboardId])
  @@index([cardId])
  @@index([createdById])
}

model WhiteboardGroup {
  whiteboardId String
  groupId      String
  whiteboard   Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([whiteboardId, groupId])
  @@index([groupId])
}

// ── MCP access (docs/MCP.md) ─────────────────────────────────────────────────
// One row per credential an AI client holds: a personal access token pasted into a
// client, or an OAuth connection (Claude.ai, Claude Desktop…). Either way it acts as
// one user in one workspace, with "read" or "read write" scope. Secrets are stored as
// SHA-256 hashes only; the plaintext is shown once (personal) or handed to the client
// (OAuth) and never kept.
model ApiToken {
  id               String       @id @default(cuid())
  userId           String
  workspaceId      String
  name             String // "Claude Code on my laptop" · the OAuth client's name
  kind             String       @default("personal") // personal / oauth
  clientId         String? // OAuth connections: the registered client
  scope            String // "read" or "read write"
  tokenHash        String       @unique // sha256 of the access token
  prefix           String // first characters of a personal token, to recognise it in the list
  refreshHash      String?      @unique // OAuth: sha256 of the current refresh token (rotated on use)
  refreshExpiresAt DateTime?
  expiresAt        DateTime? // null = never (personal tokens only)
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client           OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId])
}

// An OAuth client that registered itself (RFC 7591 dynamic client registration).
// Public clients only (PKCE, no secret), as the MCP authorization spec expects.
model OAuthClient {
  id                String      @id // the client_id: issued at registration, or a CIMD document URL
  name              String
  redirectUris      String[]
  // "none" (public client, PKCE only) unless the client registered as confidential:
  // "client_secret_basic" / "client_secret_post", with the secret's SHA-256 here.
  authMethod        String      @default("none")
  secretHash        String?
  // Client ID Metadata Document clients: when the document was last fetched.
  metadataFetchedAt DateTime?
  createdAt         DateTime    @default(now())
  tokens            ApiToken[]
  codes             OAuthCode[]
}

// A one-time authorization code, valid for ten minutes.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  userId        String
  workspaceId   String
  scope         String
  redirectUri   String
  codeChallenge String // PKCE S256
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Single sign-on and provisioning (docs/SSO.md) ────────────────────────────
// One SAML identity provider per workspace (JumpCloud first), with SCIM 2.0
// provisioning and roles derived from the provider's groups.

model SsoConnection {
  id              String           @id @default(cuid())
  workspaceId     String           @unique
  provider        String           @default("jumpcloud")
  enabled         Boolean          @default(false)
  // The identity provider, from its SAML metadata.
  idpEntityId     String?
  idpSsoUrl       String?
  idpCert         String? // PEM; may hold several certificates during a rollover
  // Email domains whose sign-in goes to this provider ("Sign in with SSO").
  domains         String[]
  groupAttribute  String           @default("memberOf")
  jitProvisioning Boolean          @default(true) // create members on first sign-in
  requireSso      Boolean          @default(false) // members (not admins) can't use a password
  // Roles from groups: the highest role any mapped group grants; defaultRole otherwise.
  manageRoles     Boolean          @default(false)
  defaultRole     Role             @default(MEMBER)
  // SCIM: a bearer token, stored hashed like API tokens.
  scimEnabled     Boolean          @default(false)
  scimTokenHash   String?          @unique
  scimTokenHint   String?
  lastScimAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities      SsoIdentity[]
  groups          IdpGroup[]
  roleMappings    SsoRoleMapping[]
  scimLogs        ScimLog[]
}

// A member as the identity provider knows them. Its id is the SCIM user id.
model SsoIdentity {
  id           String        @id @default(cuid())
  connectionId String
  userId       String
  externalId   String?
  userName     String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  connection   SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectionId, userId])
  @@index([connectionId, externalId])
}

// A group pushed by SCIM or named in a SAML assertion. Its id is the SCIM group id.
model IdpGroup {
  id           String           @id @default(cuid())
  connectionId String
  displayName  String
  externalId   String?
  fromScim     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  connection   SsoConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  members      IdpGroupMember[]

  @@unique([connectionId, displayName])
}

model IdpGroupMember {
  groupId String
  userId  String
  group   IdpGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model SsoRoleMapping {
  id           String        @id @default(cuid())
  connectionId String
  groupName    String // matched case-insensitively against the provider's group name
  role         Role
  connection   SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, groupName])
}

// Recent SCIM requests, for the admin's troubleshooting view (the last 200 are kept).
model ScimLog {
  id           String        @id @default(cuid())
  connectionId String
  method       String
  path         String
  status       Int
  summary      String
  request      Json?
  createdAt    DateTime      @default(now())
  connection   SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
}

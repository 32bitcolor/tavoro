# ─────────────────────────────────────────────────────────────────────────────
# Tavoro environment reference. Copy to `.env` and fill in real values.
#   cp .env.example .env
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── App secrets (used in BOTH local dev and Docker) ──────────────────────────
# Signs session JWTs. MUST be a long random string. Change for production.
SESSION_SECRET=change-me-openssl-rand-base64-32

# ── Local development (running `npm run dev` directly on your machine) ────────
# Point at the Postgres/Redis/MinIO you run locally (e.g. the compose services
# published to localhost). Ignored when the whole stack runs under Compose.
DATABASE_URL=postgresql://tavoro:tavoro_dev_pw@localhost:5432/tavoro?schema=public
REDIS_URL=redis://localhost:6379
# S3_ENDPOINT further down defaults to the Docker Compose service name
# (`minio`), which the app can't resolve outside Compose — for local dev,
# override it to http://localhost:9000 or image/attachment uploads will fail
# to reach MinIO.

# ── Docker Compose deployment ────────────────────────────────────────────────
# Postgres credentials. Compose builds the app's DATABASE_URL from these.
POSTGRES_USER=tavoro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tavoro

# Public hostname Caddy serves + provisions TLS for. Use a real DNS name in prod.
# For purely local testing without a domain, set DOMAIN=localhost (self-signed).
DOMAIN=tavoro.example.com
# Public base URL, used in emails, OAuth metadata and MCP links.
APP_URL=https://tavoro.example.com
# Optional: old hostnames that should redirect page visits to APP_URL (comma-separated).
# LEGACY_HOSTS=old-name.example.com
# Self-service signup creates a new workspace. It's open only until the first account
# exists; set "true" to keep it open (a multi-team instance). Otherwise admins add people,
# or they arrive through SSO.
# ALLOW_SIGNUP=true
# Who may update or roll back the server in Settings → Updates (comma-separated emails).
# Default: the admins of the oldest workspace — the one created at setup.
# INSTANCE_ADMIN_EMAILS=you@example.com
# Email Let's Encrypt uses for cert expiry notices.
ACME_EMAIL=you@example.com

# MinIO (S3-compatible object storage for attachments — wired up in Phase 1).
MINIO_ROOT_USER=tavoro
MINIO_ROOT_PASSWORD=change-me-too-strong-password

# S3 (MinIO) access for attachments and review files. Browsers never talk to
# MinIO: every upload and download streams through the app.
# S3_ENDPOINT = host the APP uses (Docker: http://minio:9000).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tavoro
S3_ACCESS_KEY=tavoro
S3_SECRET_KEY=change-me-too-strong-password
S3_REGION=us-east-1

# ── Email (SMTP) — Intake notifications ───────────────────────────────────────
# New request -> workspace admins; approved/rejected -> the requester. Leave
# SMTP_HOST unset to disable email entirely; nothing else breaks.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tavoro <no-reply@haggabasin.com>"
